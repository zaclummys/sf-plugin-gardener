<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gardener</title>
  <link rel="icon" href="/logo.svg" type="image/svg+xml">
  <style>
    :root {
      color-scheme: light dark;
      --background: #f7fdf9;
      --text: #0f2a26;
      --muted: #e3f5ea;
      --border: #bfe3cd;
      --link: #047857;
      --accent: #b45309;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --background: #07131f;
        --text: #d1fae5;
        --muted: #0c2a33;
        --border: #17483f;
        --link: #6ee7b7;
        --accent: #fbbf24;
      }
    }
    body { margin: 0; background: var(--background); color: var(--text); font: 16px/1.65 system-ui, sans-serif; }
    header { border-bottom: 1px solid var(--border); padding: 0.75rem 1.5rem; }
    header { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; }
    header a { font-weight: 600; color: var(--text); text-decoration: none; }
    .brand { display: flex; align-items: center; gap: 0.6rem; }
    .brand img { border-radius: 7px; }
    header nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
    header nav a { font-weight: 400; }
    header a:hover { color: var(--accent); }
    main { max-width: 52rem; margin: 0 auto; padding: 1.5rem; }
    a { color: var(--link); }
    h1, h2, h3 { line-height: 1.25; }
    h2 { margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--border); }
    code { background: var(--muted); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.9em; }
    pre { background: var(--muted); padding: 1rem; overflow-x: auto; border-radius: 6px; }
    pre code { background: none; padding: 0; }
    table { border-collapse: collapse; display: block; overflow-x: auto; }
    th, td { border: 1px solid var(--border); padding: 0.4rem 0.75rem; text-align: left; }
    footer { max-width: 52rem; margin: 0 auto; padding: 1rem 1.5rem 2rem; display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--border); }
    footer a:last-child { margin-left: auto; text-align: right; }
    blockquote { margin-left: 0; padding-left: 1rem; border-left: 3px solid var(--border); }
  </style>
</head>
<body>
  <header>
    <a class="brand" href="/"><img src="/logo.svg" alt="" width="28" height="28">Gardener</a>
    <nav>
      <a href="/getting-started/">Getting started</a>
      <a href="/concepts/">Concepts</a>
      <a href="/configuration/">Configure</a>
      <a href="/cli/">CLI</a>
      <a href="/rules/">Rules</a>
      <a href="/presets/">Presets</a>
      <a href="/architecture/">Architecture</a>
    </nav>
  </header>
  <main>
    {{ content }}
  </main>
  {%- assign previous = collections.catalog | getPreviousCollectionItem %}
  {%- assign next = collections.catalog | getNextCollectionItem %}
  <footer>
    {%- if previous %}
    <a href="{{ previous.url }}">&larr; {{ previous.fileSlug }}</a>
    {%- endif %}
    {%- if next %}
    <a href="{{ next.url }}">{{ next.fileSlug }} &rarr;</a>
    {%- endif %}
  </footer>
</body>
</html>
