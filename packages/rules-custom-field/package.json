{
    "name": "@sf-plugin-gardener/rules-custom-field",
    "description": "The rules of Gardener for the CustomField metadata type.",
    "version": "0.0.0",
    "type": "module",
    "license": "BSD-3-Clause",
    "author": "Isaac Ferreira",
    "engines": {
        "node": ">=22.13.0"
    },
    "dependencies": {
        "@sf-plugin-gardener/core": "^0",
        "zod": "^4"
    },
    "devDependencies": {
        "@sf-plugin-gardener/testkit": "^0",
        "@types/chai": "^5",
        "@types/mocha": "^10",
        "c8": "^12",
        "chai": "^6",
        "mocha": "^12"
    },
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        }
    },
    "files": [
        "/lib"
    ],
    "scripts": {
        "clean": "rm -rf lib coverage *.tsbuildinfo .wireit",
        "compile": "wireit",
        "test": "wireit",
        "test:unit": "wireit"
    },
    "wireit": {
        "compile": {
            "command": "tsc -p . --pretty --incremental",
            "dependencies": [
                "../core:compile"
            ],
            "files": [
                "src/**/*.ts",
                "tsconfig.json",
                "../../tsconfig.base.json"
            ],
            "output": [
                "lib/**",
                "*.tsbuildinfo"
            ],
            "clean": "if-file-deleted"
        },
        "test": {
            "dependencies": [
                "test:unit"
            ]
        },
        "test:unit": {
            "command": "c8 --config .c8rc.unit.json mocha --config .mocharc.unit.json",
            "dependencies": [
                "compile"
            ],
            "env": {
                "FORCE_COLOR": "0",
                "NO_COLOR": "1",
                "TZ": "UTC"
            },
            "files": [
                "test/unit/**",
                "test/tsconfig.json",
                ".mocharc.unit.json",
                ".c8rc.unit.json"
            ],
            "output": []
        }
    }
}
