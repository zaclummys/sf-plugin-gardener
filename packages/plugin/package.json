{
    "name": "sf-plugin-gardener",
    "description": "Gardener lints the metadata of Salesforce DX projects, as a Salesforce CLI plugin.",
    "version": "0.0.0",
    "homepage": "https://zaclummys.github.io/sf-plugin-gardener/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zaclummys/sf-plugin-gardener.git",
        "directory": "packages/plugin"
    },
    "dependencies": {
        "@oclif/core": "^5",
        "@salesforce/core": "^9",
        "@salesforce/sf-plugins-core": "^13",
        "@salesforce/source-deploy-retrieve": "^13",
        "@salesforce/ts-types": "^3",
        "@salesforce/types": "^1",
        "@sf-plugin-gardener/core": "^0",
        "@xmldom/xmldom": "^0.9",
        "minimatch": "^11",
        "zod": "^4"
    },
    "devDependencies": {
        "@oclif/plugin-help": "^7",
        "@salesforce/cli-plugins-testkit": "^5",
        "@types/chai": "^5",
        "@types/mocha": "^10",
        "c8": "^12",
        "chai": "^6",
        "mocha": "^12",
        "ts-node": "^10"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "files": [
        "/lib",
        "/messages"
    ],
    "keywords": [
        "salesforce",
        "sf-plugin",
        "sfdx-plugin",
        "lint",
        "linter",
        "gardener",
        "metadata"
    ],
    "license": "BSD-3-Clause",
    "oclif": {
        "commands": "./lib/commands",
        "bin": "sf",
        "topicSeparator": " ",
        "devPlugins": [
            "@oclif/plugin-help"
        ],
        "topics": {
            "lint": {
                "description": "Lint the metadata of a Salesforce DX project."
            }
        },
        "flexibleTaxonomy": true
    },
    "scripts": {
        "clean": "rm -rf lib tmp *.tsbuildinfo .wireit",
        "compile": "wireit",
        "prepack": "npm run compile",
        "test": "wireit",
        "test:nut": "wireit",
        "test:unit": "wireit"
    },
    "wireit": {
        "compile": {
            "command": "tsc -p . --pretty --incremental",
            "dependencies": [
                "../core:compile"
            ],
            "files": [
                "src/**/*.ts",
                "tsconfig.json",
                "../../tsconfig.base.json",
                "messages/**"
            ],
            "output": [
                "lib/**",
                "*.tsbuildinfo"
            ],
            "clean": "if-file-deleted"
        },
        "test:unit": {
            "command": "mocha --config .mocharc.unit.json",
            "dependencies": [
                "compile"
            ],
            "env": {
                "FORCE_COLOR": "0",
                "NO_COLOR": "1",
                "TZ": "UTC"
            },
            "files": [
                "test/unit/**",
                "test/tsconfig.json",
                ".mocharc.unit.json"
            ],
            "output": []
        },
        "test:nut": {
            "command": "c8 --config .c8rc.nut.json mocha --config .mocharc.nut.json",
            "dependencies": [
                "compile"
            ],
            "env": {
                "FORCE_COLOR": "0",
                "NO_COLOR": "1",
                "SF_DISABLE_TELEMETRY": "true"
            },
            "files": [
                "test/nut/**",
                "test/fixtures/**",
                "test/tsconfig.json",
                ".mocharc.nut.json",
                ".c8rc.nut.json"
            ],
            "output": []
        },
        "test": {
            "dependencies": [
                "test:unit",
                "test:nut"
            ]
        }
    },
    "exports": "./lib/index.js",
    "type": "module",
    "author": "Isaac Ferreira"
}
