{
    "all": true,
    "src": [
        "lib",
        "../core/lib"
    ],
    "exclude": [
        "**/src/index.ts",
        "**/src/services/adapters/**",
        "**/bin/**",
        "**/test/**",
        "**/node_modules/**"
    ],
    "exclude-after-remap": true,
    "reporter": [
        "text",
        "lcov"
    ],
    "reports-dir": "coverage/nut",
    "check-coverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100,
    "allowExternal": true
}
