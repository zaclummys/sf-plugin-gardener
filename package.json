{
    "name": "sf-plugin-gardener-workspace",
    "description": "The workspace of Gardener, a Salesforce CLI plugin that lints the metadata of Salesforce DX projects.",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "author": "Isaac Ferreira",
    "license": "BSD-3-Clause",
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@11ty/eleventy": "^3",
        "@eslint/js": "^10",
        "@fontsource/fredoka": "^5",
        "@stylistic/eslint-plugin": "^5",
        "@types/node": "^22",
        "eslint": "^10",
        "globals": "^17",
        "markdown-it-anchor": "^10",
        "typescript": "^6",
        "typescript-eslint": "^8",
        "wireit": "^0"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "build": "wireit",
        "clean": "rm -rf tmp .eslintcache .wireit && npm run clean --workspaces --if-present",
        "compile": "wireit",
        "docs:build": "eleventy",
        "docs:dev": "eleventy --serve",
        "lint": "wireit",
        "test": "wireit",
        "test:nut": "wireit",
        "test:unit": "wireit"
    },
    "wireit": {
        "build": {
            "dependencies": [
                "compile",
                "lint"
            ]
        },
        "compile": {
            "dependencies": [
                "./packages/core:compile",
                "./packages/testkit:compile",
                "./packages/rules-custom-field:compile",
                "./packages/rules-custom-object:compile",
                "./packages/rules-project:compile",
                "./packages/plugin:compile"
            ]
        },
        "lint": {
            "command": "eslint . --color --cache --cache-location .eslintcache",
            "dependencies": [
                "./packages/core:compile",
                "./packages/testkit:compile",
                "./packages/rules-custom-field:compile",
                "./packages/rules-custom-object:compile",
                "./packages/rules-project:compile"
            ],
            "files": [
                "packages/*/src/**/*.ts",
                "packages/*/test/**/*.ts",
                "packages/*/bin/**",
                "packages/*/messages/**",
                "eslint.config.js",
                "eleventy.config.js",
                "package.json",
                "packages/*/package.json",
                "tsconfig.base.json",
                "packages/*/tsconfig.json",
                "packages/*/test/tsconfig.json"
            ],
            "output": []
        },
        "test": {
            "dependencies": [
                "test:unit",
                "test:nut"
            ]
        },
        "test:nut": {
            "dependencies": [
                "./packages/plugin:test:nut",
                "./packages/rules-custom-field:test:nut",
                "./packages/rules-custom-object:test:nut",
                "./packages/rules-project:test:nut"
            ]
        },
        "test:unit": {
            "dependencies": [
                "./packages/core:test:unit",
                "./packages/rules-custom-field:test:unit",
                "./packages/rules-custom-object:test:unit"
            ]
        }
    }
}
